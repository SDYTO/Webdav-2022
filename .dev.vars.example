# 本地开发用的环境变量示例。
# 复制成 .dev.vars 后即可被 tools/local-preview.mjs 加载（.dev.vars 已在 .gitignore 中）。
#
# 生产环境的口令不要写进任何文件，用 Secret：
#   npx wrangler pages secret put ADMIN_PASSWORD --project-name <你的 Pages 项目名>

# 写操作用户名（明文变量，与 wrangler.toml 的 [vars] 保持一致）
ADMIN_USER=admin

# 本地预览用的写操作口令。纯本地，不是任何环境的真实凭据。
ADMIN_PASSWORD=local-dev-not-a-secret

# 回收站保留天数；-1 关闭自动清理，0 表示全部视为过期
TRASH_RETENTION_DAYS=30
